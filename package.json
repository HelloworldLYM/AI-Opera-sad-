{
  "name": "ai-opera-sad-edition",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build:immersive": "esbuild ./src/legacy/immersive-background.js --bundle --format=esm --target=es2020 --minify --outfile=./public/legacy/immersive-background.bundle.js",
    "predev": "npm run build:immersive",
    "dev": "vite",
    "setup:cpu": "powershell -ExecutionPolicy Bypass -File scripts/setup-cpu.ps1",
    "dev:cpu": "powershell -ExecutionPolicy Bypass -File scripts/start-cpu.ps1",
    "setup:gpu": "powershell -ExecutionPolicy Bypass -File scripts/setup-gpu.ps1",
    "dev:gpu": "powershell -ExecutionPolicy Bypass -File scripts/start-gpu.ps1",
    "build": "npm run build:immersive && tsc && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@mediapipe/camera_utils": "^0.3.1675466862",
    "@mediapipe/face_mesh": "^0.4.1633559619",
    "@mediapipe/hands": "^0.4.1675469240",
    "@mediapipe/tasks-vision": "^0.10.22-rc.20250304",
    "@mkkellogg/gaussian-splats-3d": "^0.4.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "three": "^0.160.0",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/three": "^0.160.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.8"
  }
}
